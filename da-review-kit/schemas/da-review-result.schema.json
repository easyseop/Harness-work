{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DA검토 OUTPUT — 검사 결과 (고정 형식)",
  "description": "모든 게이트가 동일한 형식으로 결과를 낸다. 테스트는 이 형식을 비교한다.",
  "type": "object",
  "required": ["harness", "gate", "target", "status", "summary", "findings"],
  "properties": {
    "harness": { "type": "string", "const": "da-review" },
    "gate": { "type": "string", "description": "check-physical | check-attribute | check-instance-code" },
    "target": { "type": "string", "description": "검사한 INPUT 파일 경로" },
    "project": { "type": ["string", "null"] },
    "status": { "type": "string", "enum": ["passed", "failed"] },
    "summary": {
      "type": "object",
      "required": ["errors", "warnings"],
      "properties": {
        "errors": { "type": "integer" },
        "warnings": { "type": "integer" }
      }
    },
    "skipped_nonstandard": {
      "type": "array",
      "description": "비표준으로 판정돼 검토 제외된 테이블명 목록",
      "items": { "type": "string" }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "message"],
        "properties": {
          "severity": { "type": "string", "enum": ["error", "warning"] },
          "category": { "type": "string", "enum": ["missing", "violation"], "description": "missing=정보부족(물어볼 것) / violation=표준위반(고칠 것)" },
          "scope": { "type": ["string", "null"], "description": "대상(테이블/컬럼/인스턴스)" },
          "message": { "type": "string", "description": "반송사유" },
          "suggestion": { "type": "string", "description": "권고(→ 이렇게). 현재는 틀(빈 값), 추후 정식 양식 반영" }
        }
      }
    },
    "generated_at": { "type": "string" }
  }
}
