{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "config-secret binding",
  "type": "object",
  "required": ["binding"],
  "properties": {
    "binding": {
      "type": "object",
      "required": ["for_solution", "owner_role", "variables"],
      "properties": {
        "for_solution": { "type": "string", "minLength": 1 },
        "owner_role": { "type": "string", "minLength": 1 },
        "variables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "kind", "zone", "required", "source", "description"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "kind": { "enum": ["config", "secret"] },
              "zone": { "enum": ["external-ok", "internal-only"] },
              "required": { "type": "boolean" },
              "default": {},
              "source": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 }
            },
            "allOf": [
              {
                "if": { "properties": { "kind": { "const": "secret" } } },
                "then": {
                  "properties": {
                    "zone": { "const": "internal-only" },
                    "default": { "type": "null" }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
